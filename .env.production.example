# Production — Supabase project "GammaQuality" (main branch)
# Copy to .env.production.local and fill in values from:
# Supabase Dashboard → GammaQuality → Project Settings → API

VITE_APP_ENV=production

VITE_SUPABASE_URL=https://YOUR_GAMMAQUALITY_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Supabase CLI: supabase link --project-ref YOUR_GAMMAQUALITY_PROJECT_REF
SUPABASE_PROJECT_REF=YOUR_GAMMAQUALITY_PROJECT_REF

# --- Firebase Cloud Messaging (web push). All values are PUBLIC. ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
